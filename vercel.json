{
 "$schema":"https://openapi.vercel.sh/vercel.json",
 "framework":"vite","buildCommand":"npm run build","outputDirectory":"dist","installCommand":"npm ci",
 "functions":{"api/raffle/[...path].ts":{"maxDuration":60}},
 "rewrites":[{"source":"/rifa-ledger","destination":"/index.html"}],
 "headers":[{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}]
}
