# Copy values into the server environment, never VITE_* or the GitHub repository.
RAFFLE_SUPABASE_URL=
RAFFLE_SUPABASE_ANON_KEY=
RAFFLE_SUPABASE_SERVICE_KEY=
RAFFLE_RATE_SECRET=
RAFFLE_SITE_ORIGIN=http://localhost:3000
RAFFLE_EVM_RPC_URL=
RAFFLE_SALES_ENABLED=false
RAFFLE_TEST_ENABLED=false
RAFFLE_EVM_LOGS_RPC_URL=https://bsc-rpc.publicnode.com

# Public browser identifier, not a secret. Restrict the project to the checkout domain.
VITE_WALLETCONNECT_PROJECT_ID=

# Server-only list of verified email addresses allowed to read the admin dashboard.
RAFFLE_ADMIN_EMAILS=
RAFFLE_WORKER_SECRET=

# Server-only outbound Telegram alerts; do not change an existing bot webhook.
RAFFLE_TELEGRAM_BOT_TOKEN=
RAFFLE_TELEGRAM_CHAT_ID=
